{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "target": "ESNext",    
    "module": "ES2020",
    "moduleResolution": "node",                               
    "esModuleInterop": true,                         
    "forceConsistentCasingInFileNames": true,           
    "strict": true,                                      
    "skipLibCheck": true,     
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,                          
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}